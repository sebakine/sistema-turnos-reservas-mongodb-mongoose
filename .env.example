# Copiar este archivo como .env y completar los valores reales
# Puerto en el que se levanta el servidor Express
PORT=8080

# URI de conexión a MongoDB Atlas (reemplazar usuario, contraseña, cluster y base de datos)
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/turnos_reservas?retryWrites=true&w=majority
